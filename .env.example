# ---- Jira Cloud (required) ----------------------------------------------
# Your site URL, no trailing slash.
JIRA_BASE_URL=https://your-site.atlassian.net
# The Atlassian account the bot acts as. Everything it does is attributed to
# this user and limited to this user's permissions.
JIRA_EMAIL=you@example.com
# Create at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# ---- Jira Cloud (optional) ----------------------------------------------
# Assumed when the user talks about issues without naming a project.
JIRA_DEFAULT_PROJECT=
JIRA_TIMEOUT_SECONDS=30
# Set to false for a read-only bot: the create/update/transition/comment/worklog
# tools are then not offered to the model at all.
JIRA_ALLOW_WRITES=true

# ---- Claude -------------------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# low | medium | high | xhigh | max — lower is cheaper and faster.
CLAUDE_EFFORT=high
CLAUDE_MAX_TOKENS=8000

# ---- Limits -------------------------------------------------------------
# Tool rounds allowed per user message before the bot gives up.
MAX_TOOL_ITERATIONS=12
# Conversation turns kept in context per session.
HISTORY_TURNS=20
