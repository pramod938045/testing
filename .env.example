# ---- Jira (required) -----------------------------------------------------
# Your site URL, no trailing slash. Works with both:
#   Jira Cloud            https://your-site.atlassian.net
#   Jira Data Center      https://jira.your-company.com
JIRA_BASE_URL=https://your-site.atlassian.net

# CLOUD: the Atlassian account the bot acts as, plus an API token from
#   https://id.atlassian.com/manage-profile/security/api-tokens
# DATA CENTER: leave JIRA_EMAIL blank and put a Personal Access Token here
#   (your avatar -> Profile -> Personal Access Tokens -> Create token).
#   A Cloud API token does NOT work on Data Center, and vice versa.
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# cloud | server | auto. "auto" picks Cloud for *.atlassian.net and Data
# Center for anything else, which is almost always right.
JIRA_DEPLOYMENT=auto

# ---- Jira Cloud (optional) ----------------------------------------------
# Assumed when the user talks about issues without naming a project.
JIRA_DEFAULT_PROJECT=
JIRA_TIMEOUT_SECONDS=30
# Note: there is no write switch. Both the chatbot and the story generator are
# read-only by construction and cannot create, edit or delete anything in Jira.

# ---- Slack (only for slack_bot.py) --------------------------------------
# Bot User OAuth Token from your Slack app's OAuth & Permissions page.
SLACK_BOT_TOKEN=xoxb-
# App-Level Token with the connections:write scope (Basic Information ->
# App-Level Tokens). Socket Mode needs this; no public URL is required.
SLACK_APP_TOKEN=xapp-

# ---- Claude -------------------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# low | medium | high | xhigh | max — lower is cheaper and faster.
CLAUDE_EFFORT=high
CLAUDE_MAX_TOKENS=8000

# ---- Limits -------------------------------------------------------------
# Tool rounds allowed per user message before the bot gives up.
MAX_TOOL_ITERATIONS=12
# Conversation turns kept in context per session.
HISTORY_TURNS=20
